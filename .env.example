# Copy this file to .env and fill in your values. Never commit .env.

# Which provider to use: groq | openai | anthropic | ollama
LLM_PROVIDER=groq

# Model name for the chosen provider, e.g.:
#   groq:      llama-3.1-8b-instant
#   openai:    gpt-4o-mini
#   anthropic: claude-sonnet-4-6
#   ollama:    llama3.1 (must be pulled locally first)
LLM_MODEL=llama-3.1-8b-instant

# Lighter model used ONLY for structured-output calls (evaluator, strategist).
# These calls consume the most tokens per request, so a smaller model reduces
# daily quota pressure on Groq's free tier. Only used when LLM_PROVIDER=groq.
# Set to the same value as LLM_MODEL to disable the split.
LLM_MODEL_STRUCTURED=llama-3.1-8b-instant

# Sampling temperature (0.0 - 2.0). Lower = more consistent, higher = more varied.
LLM_TEMPERATURE=0.4

# Max retries if the LLM returns malformed/unparseable structured output.
LLM_MAX_RETRIES=2

# Only the API key matching LLM_PROVIDER above needs to be set.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama runs locally — no key needed.
